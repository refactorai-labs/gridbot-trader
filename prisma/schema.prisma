generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Each simulation run with config, status, and aggregate results
model Simulation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String @default("Untitled Simulation")
  pair        String // "WETH/USDC" or "WBTC/USDC"
  poolAddress String
  chain       String @default("eth")

  startTime DateTime
  endTime   DateTime
  timeframe String   @default("1h") // "5m", "15m", "1h", "4h"
  feeRate   Float    @default(0.001) // 0.1%

  status       String  @default("pending") // pending, running, completed, failed
  errorMessage String?

  // Adaptive layer toggle
  adaptiveEnabled Boolean @default(true)
  emaPeriod       Int     @default(50)
  volumeMultiplier Float  @default(1.5)

  // Combo Bot (Dual Trailing v3.1) — opt-in supervisor wrapper
  comboBotEnabled     Boolean @default(false)
  comboMode           String? // "dual" | "long" | "short"
  comboLeverage       Float?  @default(5.0)
  comboAllocationLong Float?  @default(0.6) // fraction 0.5..0.75, only used in "dual" mode
  comboAvwapEnabled   Boolean @default(true) // feature flag for AVWAP reopen condition (ablation)
  comboGridLevels     Int     @default(10)  // grid level count used by the combo engine; persisted so UI value reaches the simulation
  fundingDataMissing  Boolean @default(false) // set when a combo run had zero funding rows for the requested window
  requireDirectionalConfirmation Boolean @default(false) // Phase 4.1: strict-side AVWAP + no-new-low/high gate

  // Aggregate results (computed after simulation)
  totalPnl       Float?
  totalPnlPct    Float?
  longPnl        Float?
  shortPnl       Float?
  totalTrades    Int?
  longTrades     Int?
  shortTrades    Int?
  winCount       Int?
  lossCount      Int?
  maxDrawdown    Float?
  maxDrawdownPct Float?
  finalEquity    Float?
  totalCandles   Int?

  // Combo cost reporting (persisted from runComboSimulationCore result)
  totalSlippageCost Float?
  longSlippageCost  Float?
  shortSlippageCost Float?
  totalFundingCost  Float?
  longFundingCost   Float?
  shortFundingCost  Float?

  // Relations
  gridConfigs    GridConfiguration[]
  gridOrders     GridOrder[]
  adaptiveEvents AdaptiveEvent[]
  pnlSnapshots   PnlSnapshot[]
  comboConfigs   ComboBotConfiguration[]
  avwapAnchor    AVWAPAnchor?

  @@index([status])
  @@index([pair])
  @@index([createdAt])
}

// Grid configuration per side (long/short) per simulation
model GridConfiguration {
  id String @id @default(cuid())

  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  side       String // "long" or "short"
  gridLevels Int    @default(10)
  gridType   String @default("arithmetic") // "arithmetic" or "geometric"
  upperBound Float
  lowerBound Float

  orderSizeType String @default("fixed") // "fixed" or "percent"
  orderSize     Float // USD amount or % of allocation
  totalCapital  Float

  profitMode            String @default("next_level") // "next_level" or "custom"
  customProfitDistance   Float?

  // Computed spacing (stored for display)
  gridSpacing    Float?
  gridSpacingPct Float?

  @@unique([simulationId, side])
  @@index([simulationId])
}

// Individual grid orders
model GridOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  side       String // "long" or "short"
  level      Int    // Grid level index
  levelPrice Float
  orderType  String // "buy" or "sell"
  orderSize  Float  // Size in USD

  status   String    @default("pending") // "pending", "filled", "cancelled"
  fillPrice Float?
  fillTime  DateTime?
  fillCandleIdx Int?

  pairedOrderId String?

  pnl    Float?
  pnlPct Float?
  fees   Float?

  sizeMultiplier Float @default(1.0)

  @@index([simulationId, side, status])
  @@index([simulationId, fillCandleIdx])
}

// Adaptive layer events
model AdaptiveEvent {
  id String @id @default(cuid())

  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  candleIdx Int
  timestamp DateTime

  eventType   String // "trend_change", "breakout_detected", "de_risk", "re_entry", "grid_resize"
  detailsJson String // JSON with event-specific details

  longMultiplier  Float?
  shortMultiplier Float?

  @@index([simulationId, candleIdx])
}

// P&L snapshots for equity curve
model PnlSnapshot {
  id String @id @default(cuid())

  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  candleIdx Int
  timestamp DateTime

  price              Float
  equity             Float
  realizedPnl        Float
  unrealizedPnl      Float
  longRealizedPnl    Float @default(0)
  shortRealizedPnl   Float @default(0)
  longUnrealizedPnl  Float @default(0)
  shortUnrealizedPnl Float @default(0)
  longEquity         Float
  shortEquity        Float

  longOrdersActive  Int
  shortOrdersActive Int
  longFillCount     Int
  shortFillCount    Int

  @@index([simulationId, candleIdx])
}

// Binance perpetual funding rate cache (8h intervals)
model BinanceFundingRate {
  id          Int    @id @default(autoincrement())
  symbol      String // e.g. "ETHUSDT"
  fundingTime BigInt // unix ms
  fundingRate Float  // signed — positive: longs pay shorts; negative: shorts pay longs

  @@unique([symbol, fundingTime])
  @@index([symbol, fundingTime])
}

// Binance OHLCV candle data cache
model BinanceCandle {
  id       Int    @id @default(autoincrement())
  pair     String
  openTime BigInt
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float
  interval String

  @@unique([pair, openTime, interval])
  @@index([pair, interval, openTime])
}

// DCA trade log for backtesting results
model DCATradeLog {
  id              Int    @id @default(autoincrement())
  simulationId    String
  tradeNumber     Int
  direction       String
  baseOrderPrice  Float
  baseOrderSize   Float
  avgEntryPrice   Float
  safetyOrdersFilled Int
  closePrice      Float
  closeReason     String
  pnl             Float
  pnlPercent      Float
  openTime        BigInt
  closeTime       BigInt
  durationMinutes Int

  @@index([simulationId])
}

// Combo Bot per-side configuration (long/short under the supervisor)
model ComboBotConfiguration {
  id String @id @default(cuid())

  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  side String // "long" or "short"

  // Pyramid / averaging depth — 5 for long, 2 for short per spec §1
  averagingDepth Int @default(5)

  // Stop-loss: combined base% + ATR×k, clamped to [floor, cap]
  slBasePercent   Float @default(0.015) // 1.5%
  slAtrMultiplier Float @default(1.0)
  slFloor         Float @default(0.020) // 2.0% long-side minimum SL; short configs are stored explicitly
  slCap           Float @default(0.060) // 6.0% long-side maximum SL; short configs are stored explicitly

  // Reopen tier sizing fractions (of baseline) — 25/50/100 per spec §6
  tier1Size Float @default(0.25)
  tier2Size Float @default(0.50)
  tier3Size Float @default(1.00)

  // Cooldown & retry controls
  cooldownCandles     Int @default(12)   // one hour on 5m
  retryCap            Int @default(2)    // hibernate when retryCount >= retryCap (spec §1)
  hibernationCandles  Int @default(288)  // 24h on 5m — exit only when ER<0.3 sustained

  @@unique([simulationId, side])
  @@index([simulationId])
}

// Persisted Anchored VWAP anchor — spec §10.4 requires deterministic recomputation
model AVWAPAnchor {
  id String @id @default(cuid())

  simulationId String @unique
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  anchorCandleIdx     Int
  anchorTimestamp     DateTime
  anchorTypicalPrice  Float
  anchorVolume        Float

  createdAt DateTime @default(now())
}

// Saved configuration presets
model SavedConfiguration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String @default("")
  configJson  String // Full serialized config

  pair       String
  longLevels Int
  shortLevels Int
  gridType   String

  @@index([pair])
}
